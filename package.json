{
  "name": "nie-slot-monitor",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsup src/index.ts --format esm --platform node --target node20 --clean",
    "start:prod": "node dist/index.js",
    "sync:catalog": "npx tsx src/scripts/sync-catalog.ts --provinces=Barcelona,Madrid,Valencia",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "codegen": "playwright codegen",
    "codegen:nie": "playwright codegen --channel=chrome --lang=es-ES --timezone=Europe/Madrid"
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "dotenv": "^16.4.7",
    "playwright": "^1.49.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
