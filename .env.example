NODE_ENV=development

# NIE Appointment Portal & Applicant Details
APPOINTMENT_URL=http:example.com
BASE_URL=

# Chrome DevTools Protocol endpoint (your manual Chrome session)
CDP_URL=http://127.0.0.1:9222


# Keep the Chrome tab open when slots are found so you can book immediately
KEEP_TAB_ON_SLOT=true

# Telegram Bot Credentials
TELEGRAM_BOT_TOKEN=123456789:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Your own Telegram chat ID (receives startup, error, and WAF reports)
TELEGRAM_CHAT_ID=123456789

# Optional: comma-separated chat IDs allowed to use the bot (empty = allow everyone)
ALLOWED_CHAT_IDS=123456789,987654321

# Optional: send dev messages to a separate test chat/group (falls back to TELEGRAM_CHAT_ID)
DEV_TELEGRAM_CHAT_ID=

# Telegram Webhook Worker settings
# Public HTTPS base URL pointing to this machine (e.g. Cloudflare Tunnel, Nginx, or ngrok)
TELEGRAM_WEBHOOK_URL=https://bot.yourdomain.com
TELEGRAM_WEBHOOK_PATH=/telegram/webhook
TELEGRAM_WEBHOOK_PORT=3001
# Random secret string (A-Z, a-z, 0-9, _, -) used to verify incoming Telegram requests
TELEGRAM_WEBHOOK_SECRET=replace_with_a_long_random_secret

# Polling Window (seconds) — random jitter between min and max
POLL_MIN_SEC=15
POLL_MAX_SEC=60

# Cooldown (seconds) before re-sending identical slot alerts
ALERT_COOLDOWN_SEC=300

# Send a Telegram alert after N consecutive errors or rejections
ERROR_ALERT_THRESHOLD=5